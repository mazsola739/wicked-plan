{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/*.md", "!**/package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140, "lineEnding": "lf" },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useImportType": "off" },
      "suspicious": { "useIterableCallbackReturn": "warn" }
    }
  }
}
